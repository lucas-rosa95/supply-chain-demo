{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", "^0.8.35"],
    "func-visibility": ["error", { "ignoreConstructors": false }],
    "state-visibility": "error",
    "custom-errors": "error",
    "reason-string": "off",
    "no-empty-blocks": "warn",
    "max-line-length": ["warn", 120]
  }
}
