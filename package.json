{
  "name": "supply-chain-demo",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:sol": "hardhat test solidity",
    "test:ts": "hardhat test nodejs",
    "coverage": "hardhat test --coverage",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,sol,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,sol,json,md}\"",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.6",
    "@types/node": "^22.19.19",
    "forge-std": "github:foundry-rs/forge-std#v1.11.0",
    "hardhat": "^3.7.0",
    "prettier": "^3.8.4",
    "prettier-plugin-solidity": "^2.3.1",
    "solhint": "^6.2.1",
    "typescript": "~6.0.3",
    "viem": "^2.51.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
